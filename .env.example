# Copy to .env (gitignored). Use either a key file path OR the id/secret pair.
CDP_KEY_FILE=~/path/to/cdp_api_key.json
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# For auth = "bearer" (e.g. your own implementation):
# TRANSFERS_API_TOKEN=

# Optional overrides:
# TRANSFERS_BASE_URL=http://localhost:8000
# TRANSFERS_CONFIG=config.staging.toml
